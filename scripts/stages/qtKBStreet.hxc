import flixel.FlxG;
import funkin.play.stage.Stage;
import funkin.play.PlayState;
import funkin.graphics.shaders.DropShadowShader;
import funkin.play.character.CharacterType;

class QTKBStreetStage extends Stage
{
    var kbShader:DropShadowShader;
    var gfShader:DropShadowShader;
    var bfShader:DropShadowShader;
    var gasSongs:Array<String> = ["censory-overload"];

    function new() {
        super('qtKBStreet');
    }

    override function onCreate(event:ScriptEvent):Void {
        super.onCreate(event);
        onRestart();
    }

    override function onSongRetry(event:ScriptEvent):Void {
        super.onSongRetry(event);
        onRestart();
        PlayState.instance.currentStage.getNamedProp("TV").playAnimation("idle", true);
    }

    override function onGameOver(event:ScriptEvent):Void {
        getBoyfriend().shader = null;
        super.onGameOver(event);
    }

    override function onBeatHit(event:SongTimeScriptEvent):Void {
        super.onBeatHit(event);

        if (PlayState.instance.currentStage.getNamedProp('TV') == null) return;
        var tvAnim:String = PlayState.instance.currentStage.getNamedProp('TV').getCurrentAnimation();
        if (tvAnim == "alert" || tvAnim == "heart") PlayState.instance.currentStage.getNamedProp('TV').playAnimation(tvAnim, true);
    }

    override function buildStage():Void {
        super.buildStage();
        if (!gasSongs.contains(PlayState.instance.currentSong.id)) {
            PlayState.instance.currentStage.getNamedProp('gas1')?.kill();
            PlayState.instance.currentStage.getNamedProp('gas2')?.kill();
        }
    }

    override public function add(spr:FlxSprite):FlxSprite
	{
        if (spr != null && spr.antialiasing != false) spr.antialiasing = DpzGlobalsModule.getAntialias();
        return super.add(spr);
	}

    override function addCharacter(character:BaseCharacter, charType:CharacterType):Void {
        super.addCharacter(character, charType);
        if (!DpzGlobalsModule.qualityLevel(2)) return;

        var rim = new DropShadowShader();
        rim.color = 0xFF338FD6;
        rim.attachedSprite = character;
        rim.angle = 90;
        rim.distance = 20;
        if (!DpzGlobalsModule.qualityLevel(3)) rim.antialiasAmt = 0;

        switch (charType) {
            case CharacterType.BF:
                rim.angle = 67.75;
                character.animation.onFrameChange.add(function() {
                    if (getBoyfriend() != null) rim.updateFrameInfo(getBoyfriend().frame);
                });
                bfShader = rim;
            case CharacterType.GF:
                rim.distance = 34;
                character.animation.onFrameChange.add(function() {
                    rim.updateFrameInfo(getGirlfriend().frame);
                });
                if (getGirlfriend().characterId == 'nene')
                {
                    rim.loadAltMask(Paths.image('qtMasks/nene_mask'));
                    rim.maskThreshold = 0.4;
                    rim.useAltMask = true;
                }
                gfShader = rim;
            case CharacterType.DAD:
                rim.angle = 112.25;
                character.animation.onFrameChange.add(function() {
                    rim.updateFrameInfo(getDad().frame);
                });
                kbShader = rim;
            default:
        }
        character.shader = rim;
        character.shader = null; // idk if this makes a difference-
    }

    // Pretty well-coded code, isn't it?
    public function revealError(daCase:Int) {
        switch(daCase) {
            case 1:// 1 to set error
                applyShaders(true);
                PlayState.instance.currentStage.getNamedProp('BG-error').revive();
                PlayState.instance.currentStage.getNamedProp('FG-error').revive();
                PlayState.instance.currentStage.getNamedProp('BG-pre').kill();
                PlayState.instance.currentStage.getNamedProp('BG').kill();
                PlayState.instance.currentStage.getNamedProp('FG').kill();
            case 2: // 2 to set it to pre-error
                PlayState.instance.currentStage.getNamedProp('BG-error').kill();
                PlayState.instance.currentStage.getNamedProp('FG-error').kill();
                PlayState.instance.currentStage.getNamedProp('BG-pre').revive();
                PlayState.instance.currentStage.getNamedProp('BG').kill();
                PlayState.instance.currentStage.getNamedProp('FG').revive();
                FlxG.camera.shake(0.0078, 0.675);
            default: // anything else to set it to normal
                applyShaders(false);
                PlayState.instance.currentStage.getNamedProp('BG-error').kill();
                PlayState.instance.currentStage.getNamedProp('FG-error').kill();
                PlayState.instance.currentStage.getNamedProp('BG-pre').kill();
                PlayState.instance.currentStage.getNamedProp('BG').revive();
                PlayState.instance.currentStage.getNamedProp('FG').revive();
        }
    }

    public function killGas() {
        PlayState.instance.currentStage.getNamedProp('gas1')?.kill();
        PlayState.instance.currentStage.getNamedProp('gas2')?.kill();
    }

    function prepareGas() {
        var gas1 = PlayState.instance.currentStage.getNamedProp('gas1');
        var gas2 = PlayState.instance.currentStage.getNamedProp('gas2');
        var xVariation:Int = 1680;
        var yVariation:Int = -600;

        gas1.danceEvery = 0.0;
        gas2.danceEvery = 0.0;
        gas1.cameras = [PlayState.instance.camHUD];
        gas2.cameras = [PlayState.instance.camHUD];
        gas1.setPosition(0 - xVariation, yVariation);
        gas2.setPosition(FlxG.width - gas2.width + xVariation, yVariation);
        gas1.angle = -31;
        gas2.angle = 31;
        gas1.zIndex = 1002;
        gas2.zIndex = 1003;
        gas1.antialiasing = !FlxG.onMobile;
        gas2.antialiasing = !FlxG.onMobile;
    }

    function onRestart() {
        PlayState.instance.currentStage.getNamedProp('TV')?.danceEvery = 0.0;
        PlayState.instance.currentStage.getNamedProp('gas1')?.antialiasing = !(FlxG.onMobile);
        PlayState.instance.currentStage.getNamedProp('gas2')?.antialiasing = !(FlxG.onMobile);
        PlayState.instance.currentStage.getNamedProp('TV')?.antialiasing = !(FlxG.onMobile);
        prepareGas();
        if (!DpzGlobalsModule.qualityLevel(2)) killGas(); // gas only on high
        revealError(0);
    }

    function applyShaders(on:Bool) {
        if (!DpzGlobalsModule.qualityLevel(2)) return;
        if (on) {
            getBoyfriend()?.shader = bfShader;
            getGirlfriend()?.shader = gfShader;
            getDad()?.shader = kbShader;
        } else {
            getBoyfriend()?.shader = null;
            getGirlfriend()?.shader = null;
            getDad()?.shader = null;
        }
    }
}