import funkin.play.PlayState;
import funkin.play.PlayStatePlaylist;
import funkin.play.song.Song;
import flixel.FlxG;

import Date;

class QTCarelessSong extends Song {
    var hasPlayedCutscene:Bool;
    var hasPlayedEndCutscene:Bool;
    public function new() {
        super('careless');
    }

    override function onCreate(event:ScriptEvent):Void {
        super.onCreate(event);

        discordRPC();

        hasPlayedCutscene = false;
        hasPlayedEndCutscene = !(PlayStatePlaylist.isStoryMode);
    }

    override function onSongRetry(event:ScriptEvent):Void {
        super.onSongRetry(event);
        hasPlayedCutscene = true;
        hasPlayedEndCutscene = !(PlayStatePlaylist.isStoryMode);
    }

    override function onCountdownStart(event:CountdownScriptEvent):Void {
        super.onCountdownStart(event);
        if (!(PlayStatePlaylist.isStoryMode) || PlayState.instance.isChartingMode || hasPlayedCutscene) return;

        hasPlayedCutscene = true;
        event.cancel();
        startDialogue();
    }

    override function onSongEnd(event:CountdownScriptEvent):Void {
        if (!hasPlayedEndCutscene) {
            hasPlayedEndCutscene = true;
            PlayState.instance.disableKeys = false;
            startEndDialogue();

            event.cancel();
        } else {
            hasPlayedEndCutscene = false;
            PlayState.instance.disableKeys = true;
            super.onSongEnd(event);
        }
    }

    function startDialogue() {
        PlayState.instance.startConversation('careless');
    }

    function startEndDialogue() {
        PlayState.instance.startConversation('careless-end');
    }

    override function onDialogueEnd() {
        if (!hasPlayedCutscene) Countdown.performCountdown();
    }

    function discordRPC() {
        if (FlxG.onMobile || PlayState.instance == null) return;

        var daTime = Date.now().getTime();
        var daAlbum:String = PlayState.instance.currentChart.album;
        var daIcon:String = null;

        var dummyDad = PlayState.instance.currentStage.getDad();
        if (dummyDad != null) daIcon = dummyDad._data?.healthIcon?.id;

        if (daAlbum != null && daAlbum != "") PlayState.instance.discordRPCAlbum = "https://raw.githubusercontent.com/mateo360p/QT-Mod-V-slice/refs/heads/Port-art/discord/albums/" + daAlbum + ".png?raw=true?t=" + daTime;
        if (daIcon != null && daIcon != "") PlayState.instance.discordRPCIcon = "https://raw.githubusercontent.com/mateo360p/QT-Mod-V-slice/refs/heads/Port-art/discord/icons/" + daIcon + ".png?raw=true?t=" + daTime;
    }
}