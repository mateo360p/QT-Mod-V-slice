package dipazio.song;

import flixel.FlxG;
import funkin.graphics.FunkinSprite;
import flixel.tweens.FlxEase;
import funkin.play.PlayState;
import funkin.Preferences;
import funkin.play.notes.StrumlineNote;
import funkin.Conductor;
import flixel.math.FlxPoint;
import funkin.modding.module.ModuleHandler;
import dipazio.song.DpzSong;

using StringTools;

// Well, moving notes is fkin hell- but possible :u
class QTTerminationSong extends DpzSong {
    var inAngleRotating:Bool = false;
    var pincer1:FunkinSprite;
    var pincer2:FunkinSprite;
    var pincer3:FunkinSprite;
    var pincer4:FunkinSprite;

    public function new() {
        super('termination', null,
        {
            startDialogue: false, // Boolean, needs explanation?
            endDialogue: false, // Boolean
            freeplayDialogue: false, // Boolean
            discordRich: true, // Boolean
            albumMod: "QT" // String, the external site link getter for the songs album cover
        });
    }

    function moveNote(note:Int, daX:Float, daY:Float, time:Float, ease:FlxEase = null) {
        if (FlxG.onMobile) return; // the note movement keeps lagging the game on mobile, so let's remove it!
        var dumEase = FlxEase.quadOut;
        if (ease != null) dumEase = ease;

        if (daX != null) ModuleHandler.getModule("ChangeStrumlineModule").scriptCall("tweenXOffset", [note, daX, time, {ease: dumEase}]);
        if (daY != null) ModuleHandler.getModule("ChangeStrumlineModule").scriptCall("tweenYOffset", [note, daY, time, {ease: dumEase}]);

        var curpincer = getArrowPincer(note);
        if (curpincer == null) return;

        var dnote:Int = note; var dX:Float = daX; var dY:Float = daY;
        DpzGlobalsModule.cancelTweensOf(curpincer);
        if (daX != null) DpzGlobalsModule.tween(curpincer, {x: getStartPos(dnote).x + dX}, time, {ease: dumEase});
        if (daY != null) DpzGlobalsModule.tween(curpincer, {y: getStartPos(dnote).y + (dY * (Preferences.downscroll ? 1 : -1))}, time, {ease: dumEase});
    }

    function getStartPos(note:Int):FlxPoint {
        return ModuleHandler.getModule("ChangeStrumlineModule").scriptCall("getStartPos", [note]);
    }

    function addToNote(note:Int, daX:Float, daY:Float, time:Float, ease:FlxEase = null) {
        if (FlxG.onMobile) return;
        var dumEase = FlxEase.quadOut;
        if (ease != null) dumEase = ease;

        ModuleHandler.getModule("ChangeStrumlineModule").scriptCall("addTweenXOffset", [note, daX, time, {ease: dumEase}]);
        ModuleHandler.getModule("ChangeStrumlineModule").scriptCall("addTweenYOffset", [note, daY, time, {ease: dumEase}]);

        var curpincer = getArrowPincer(note);
        if (curpincer == null) return;

        var dX:Float = daX; var dY:Float = daY;
        DpzGlobalsModule.cancelTweensOf(curpincer);
        DpzGlobalsModule.tween(curpincer, {x: curpincer.x + dX, y: curpincer.y + (dY * (Preferences.downscroll ? 1 : -1))}, time, {ease: dumEase});
    }

    function fetchAssetPaths():Array<String> // These are in the stage data, so they should have been preloaded, but just in case-
	{
		var results:Array<String> = super.fetchAssetPaths();

        results.push(Paths.image("hazardStuff/inhuman-port/back-Gradient"));
        results.push(Paths.getSparrowAtlas("hazardStuff/qt-port/stage/Gas_Release"));
		results.push(Paths.getSparrowAtlas("hazardStuff/qt-port/attack_alert_NEW"));
        results.push(Paths.getSparrowAtlas("hazardStuff/qt-port/attackv6"));
        results.push(Paths.sound("hazard/dodge01"));
        results.push(Paths.sound("hazard/bonk"));
		for (i in ["Double", "Triple", "Quadruple", ""]) results.push(Paths.sound("hazard/alert" + i));
        for (i in ["-double", "-triple", "-quadruple", ""]) results.push(Paths.sound("hazard/attack" + i));
        results.push(Paths.image("hazardStuff/qt-port/pincer-open"));
        results.push(Paths.image("hazardStuff/qt-port/pincer-close"));

		return results;
	}

    override function onCreate(event:ScriptEvent):Void {
        super.onCreate(event);

        if (!DpzQTModule.disabledTricks()) ModuleHandler.getModule("ChangeStrumlineModule").scriptCall("startMovableNotes");
        inAngleRotating = false;
        createPincers();
        nonVisibleStaticArrows();
        resetCameraAngle();
        PlayState.instance.currentStage?.scriptCall("killGas");
    }

    override function onSongRetry(event:ScriptEvent):Void {
        super.onSongRetry(event);

        inAngleRotating = false;
        restartPincers();
        nonVisibleStaticArrows();
        resetCameraAngle();
        PlayState.instance.currentStage?.getGirlfriend().canPlayOtherAnims = true;
        if (isPico()) PlayState.instance.currentStage?.getGirlfriend().playAnimation('scared', true);
        PlayState.instance.currentStage?.scriptCall("killGas");
    }

    override function onUpdate(event:UpdateScriptEvent):Void {
        super.onUpdate(event);
        if (PlayState.instance != null) cameraAngleMovement();
    }

    override function onBeatHit(event:SongTimeScriptEvent):Void {
        super.onBeatHit(event);
        if ((event.beat > 24 && event.beat < 640) || event.beat > 1088) return;
        if (event.beat == 0 || event.beat == 8 || event.beat == 16 || event.beat == 24) terminationIntroShit(Std.int(event.beat / 8));
        switch (event.beat) {
            case 640:
                changeIdle("-alt");
            case 702:
                PlayState.instance.currentStage.scriptCall("revealError", [2]);
                DpzGlobalsModule.shakeCameras(0.0133, 0.0132, 0.54);
                changeIdle("-angry");
                if (!isPico()) {
                    PlayState.instance.currentStage.getGirlfriend().playAnimation('qtScaredTermination', true);
                    PlayState.instance.currentStage.getGirlfriend().canPlayOtherAnims = false;
                }
                setKBDrain(0.1);
            case 704:
                PlayState.instance.currentStage.scriptCall("revealError", [1]);
                setKBDrain(0.01, 1.1275);
            case 831:
                setKBDrain(0.0125, 1.2);
            case 832:
                PlayState.instance.currentStage.scriptCall("revealError", [0]);
                changeIdle("");
            case 834:
                if (!isPico())  {
                    PlayState.instance.currentStage.getGirlfriend().canPlayOtherAnims = true;
                    PlayState.instance.currentStage.getGirlfriend().playAnimation('scared', true);
                }
            case 1088:
                changeIdle("-alt");
            case 1152:
                terminationEnd(); // clearing all the posible missing notes, fanciness!
        }
    }

    override function onStepHit(event:SongTimeScriptEvent):Void {
        super.onStepHit(event);

        if (DpzQTModule.disabledTricks()) return;

        switch (event.step) {
            case 1280:
                kbPincerState(0);
            case 1288:
                kbPincerState(1);
            case 1296:
                kbPincerState(2);
            case 1344:
                kbPincerState(3);
            case 1352:
                kbPincerState(4);
            case 1360:
                kbPincerState(5);
            case 1408:
                kbPincerState(6);
            case 1416:
                kbPincerState(7);
            case 1424:
                kbPincerState(8);
            case 1472:
                kbPincerState(9);
            case 1480:
                kbPincerState(10);
            case 1488:
                kbPincerState(11);
            case 1531:
                kbPincerState(12);
            case 1536:
                kbPincerState(13);
            case 1552:
                kbPincerState(14);
            case 1568:
                kbPincerState(15);
            case 1584:
                kbPincerState(16);
            case 1600:
                kbPincerState(17);
            case 1616:
                kbPincerState(18);
            case 1632:
                kbPincerState(19);
            case 1648:
                kbPincerState(20);
            case 1792:
                kbPincerState(21);
            case 2040:
                kbPincerState(22);
            case 2048:
                kbPincerState(23);
            case 2560:
                kbPincerState(24);
        }
    }

    function kbPincerState(state:Int) {
        switch(state) {
            // MOVENOTE(ID, X, Y, TIME) -> ID: 0l, 1d, 2u, 3r
            //first pincer move
            case 0:
                ModuleHandler.getModule("ChangeStrumlineModule").scriptCall("setAllowedMoving", [true]);
                kbPincerPrepare(6, false);
            case 1:
                kbPincerGrab(6);
                addToNote(2, 0, -70, 0.25); // move up

            case 2:
                kbPincerPrepare(6, true);

            //2nd pincer move
            case 3:
                kbPincerPrepare(4, false);
                kbPincerPrepare(6, false);
            case 4:
                kbPincerGrab(4);
                kbPincerGrab(6);

                moveNote(2, 0, 0, 0.3); // reset up
                addToNote(0, -25, -62, 0.25); // move left

            case 5:
                kbPincerPrepare(6, true);
                kbPincerPrepare(4, true);

            //3rd pincer move
            case 6:
                kbPincerPrepare(4, false);
                kbPincerPrepare(5, false);
                kbPincerPrepare(7, false);
            case 7:
                kbPincerGrab(4);
                kbPincerGrab(5);
                kbPincerGrab(7);

                moveNote(0, 0, 0, 0.3); // reset left
                addToNote(1, 11, -70, 0.25); // move down
                addToNote(3, 50, -40, 0.25); // move right

            case 8:
                kbPincerPrepare(4, true);
                kbPincerPrepare(5, true);
                kbPincerPrepare(7, true);

            //4th pincer move
            case 9: 
                kbPincerPrepare(4, false);
                kbPincerPrepare(5, false);
                kbPincerPrepare(6, false);
                kbPincerPrepare(7, false);
            case 10:
                kbPincerGrab(4);
                kbPincerGrab(5);
                kbPincerGrab(6);
                kbPincerGrab(7);

                addToNote(0, -16, -32, 0.25); // move left
                moveNote(1, 0, 0, 0.3); // reset down
                moveNote(2, 0, 0, 0.3); // reset up
                moveNote(3, 16, -32, 0.25); // move right
                ModuleHandler.getModule("ChangeStrumlineModule")?.scriptCall("tweenAngle", [0, 40, 0.25, {ease: FlxEase.linear}]);
                ModuleHandler.getModule("ChangeStrumlineModule")?.scriptCall("tweenAngle", [3, -40, 0.25, {ease: FlxEase.linear}]);

            case 11:
                kbPincerPrepare(4, true);
                kbPincerPrepare(5, true);
                kbPincerPrepare(6, true);
                kbPincerPrepare(7, true);
            
            //Long section
            case 12:
                kbPincerPrepare(4, false);
                kbPincerPrepare(7, false);
            case 13:
                kbPincerGrab(4);
                kbPincerGrab(7);

                moveNote(0, 0, -75, 0.75, FlxEase.quadInOut); // reset and prepare left
                moveNote(3, 0, 75, 0.75, FlxEase.quadInOut); // reset and prepare right

            case 14:
                moveNote(0, getStartPos(3).x - getArrowNote(4).x, null, 0.9, FlxEase.quadInOut); // big move left
                moveNote(3, getStartPos(0).x - getArrowNote(7).x, null, 0.9, FlxEase.quadInOut); // big move right

            case 15:
                moveNote(0, null, 0, 0.75, FlxEase.quadInOut); // settling left on right
                moveNote(3, null, 0, 0.75, FlxEase.quadInOut); // settling right on left
                ModuleHandler.getModule("ChangeStrumlineModule")?.scriptCall("tweenResetAngles", [0.725, {ease: FlxEase.quadOut}]);

            case 16:
                kbPincerPrepare(4, true);
                kbPincerPrepare(7, true);

                if (!isPico()) { // If it's pico only 2 strums switch their positions, I'm not a monster
                    kbPincerPrepare(5, false);
                    kbPincerPrepare(6, false);
                }
            case 17:
                if (!isPico()) {
                    kbPincerGrab(5);
                    kbPincerGrab(6);

                    moveNote(1, 0, 75, 0.75, FlxEase.quadInOut); // reset and prepare down
                    moveNote(2, 0, -75, 0.75, FlxEase.quadInOut); // reset and prepare up
                }

            case 18:
                if (!isPico()) {
                    moveNote(1, getStartPos(2).x - getArrowNote(5).x, null, 0.9, FlxEase.quadInOut); // "big" move down
                    moveNote(2, getStartPos(1).x - getArrowNote(6).x, null, 0.9, FlxEase.quadInOut); // "big" move up
                }

            case 19:
                if (!isPico()) {
                    moveNote(1, null, 0, 0.75, FlxEase.quadInOut); // settling down on up
                    moveNote(2, null, 0, 0.75, FlxEase.quadInOut); // settling up on down
                }

            case 20:
                if (!isPico()) {
                    kbPincerPrepare(5, true);
                    kbPincerPrepare(6, true);
                }
            case 21:
                ModuleHandler.getModule("ChangeStrumlineModule")?.scriptCall("tweenResetOffsets", [1.375, {onComplete: function(v) {ModuleHandler.getModule("ChangeStrumlineModule").scriptCall("setAllowedMoving", [false]);}}]);
            case 22: //Prepare screenshake
                var dummy = 0;
                if (!DpzGlobalsModule.hasKeyboard()) dummy = 4;
                kbPincerPrepare(dummy, false, true);
                kbPincerPrepare(7, false, true);
            case 23: //SHAKEY SHAKEY
                var dummy = 0;
                if (!DpzGlobalsModule.hasKeyboard()) dummy = 4;
                kbPincerGrab(dummy, true);
                kbPincerGrab(7, true);
                inAngleRotating = true;
            case 24: //Screenshake end
                var dummy = 0;
                if (!DpzGlobalsModule.hasKeyboard()) dummy = 4;
                kbPincerPrepare(dummy, true, true);
                kbPincerPrepare(7, true, true);
                inAngleRotating = false;
                resetCameraAngle();
        }
    }

    override function onNoteHit(event:HitNoteScriptEvent):Void {
        if (event.eventCanceled) return;
        if (event.note.kind == "qt_outro_fade") terminationOutroShit(event.note.noteData.data, event.note.noteData.getMustHitNote());
        super.onNoteHit(event);
    }

    function setKBDrain(drain:Float, loss:Float = null) {
        if (PlayState.instance.currentStage.getDad().characterId != "qt_kb") return;
        PlayState.instance.currentStage.getDad().scriptCall("setDrain", [drain, loss]);
    }

    function changeIdle(suffix:String) {
        var kb = PlayState.instance.currentStage.getDad();
        if (kb == null) return;
        kb.idleSuffix = suffix;
        kb.shouldAlternate = (suffix == "");
    }

    function createPincers() {
        pincer1 = new FunkinSprite(0, 0).loadTexture('hazardStuff/qt-port/pincer-close');
		pincer1.scrollFactor.set();
		pincer2 = new FunkinSprite(0, 0).loadTexture('hazardStuff/qt-port/pincer-close');
		pincer2.scrollFactor.set();
		pincer3 = new FunkinSprite(0, 0).loadTexture('hazardStuff/qt-port/pincer-close');
		pincer3.scrollFactor.set();
		pincer4 = new FunkinSprite(0, 0).loadTexture('hazardStuff/qt-port/pincer-close');
		pincer4.scrollFactor.set();

        restartPincers();
        pincer1.cameras = pincer2.cameras = pincer3.cameras = pincer4.cameras = [PlayState.instance.camHUD];
        PlayState.instance.add(pincer1); PlayState.instance.add(pincer2);
        PlayState.instance.add(pincer3); PlayState.instance.add(pincer4);
        PlayState.instance.refresh(); // idk
    }

    function restartPincers() {
        var daX:Float = (Preferences.downscroll || FlxG.onMobile ? 160 : 200);
        var daY:Float = (Preferences.downscroll || FlxG.onMobile ? -100 : 240);
        var daAngle:Float = (Preferences.downscroll || FlxG.onMobile ? 270 : 90);

        pincer1.angle = pincer2.angle = pincer3.angle = pincer4.angle = daAngle;
        pincer1.offset.set(daX, daY);
        pincer2.offset.set(daX, daY);
        pincer3.offset.set(daX, daY);
        pincer4.offset.set(daX, daY);
        pincer1.visible = pincer2.visible = pincer3.visible = pincer4.visible = false;
        pincer1.zIndex = pincer2.zIndex = pincer3.zIndex = pincer4.zIndex = 2000;
    }

    ////--- Events 

    // laneID 0-3: opponent notes
    // laneID 4-7: player notes
    public function kbPincerPrepare(note:Int, goesAway:Bool, ?force:Bool = false) {
        if (!force && FlxG.onMobile) return;
        var dummyPincer = getArrowPincer(note);
        if (dummyPincer == null) return;

        var daArrow = getArrowNote(note);
        dummyPincer.loadTexture('hazardStuff/qt-port/pincer-open');

        var daY:Float = (Preferences.downscroll || FlxG.onMobile ? 500 : -500);
        if(goesAway) DpzGlobalsModule.tween(dummyPincer, {y: daArrow.y + daY}, 0.4, {ease: FlxEase.backIn});
        else {
            dummyPincer.setPosition(daArrow.x, daArrow.y + daY);
            DpzGlobalsModule.tween(dummyPincer, {y: daArrow.y}, 0.3, {ease: FlxEase.elasticOut});
        }
        trace("Prepared Pincer: " + note + ", current step: " + Conductor.instance.currentStep);
        dummyPincer.visible = true;
	}

	function kbPincerGrab(note:Int, ?force:Bool = false):Void {
        if (!force && FlxG.onMobile) return;
        var dummyPincer = getArrowPincer(note);
        dummyPincer?.loadTexture('hazardStuff/qt-port/pincer-close');
	}

    // Screen rotating
    function cameraAngleMovement() {
        if (Conductor.instance == null || !inAngleRotating) return;
        PlayState.instance.camHUD.angle = Math.sin((Conductor.instance.songPosition / Conductor.instance.beatLengthMs) * Math.PI) * 5;
    }

    // Reset camera angle from rotating
    function resetCameraAngle() {
        if (Conductor.instance == null || inAngleRotating) return;
        PlayState.instance.camHUD.angle = 0;
    }

    function nonVisibleStaticArrows() {
        for (i in 0...PlayState.instance.playerStrumline.strumlineNotes.members.length)
            PlayState.instance.playerStrumline.strumlineNotes.members[i].visible = false;

        for (i in 0...PlayState.instance.opponentStrumline.strumlineNotes.members.length)
            PlayState.instance.opponentStrumline.strumlineNotes.members[i].visible = false;
    }

    function terminationIntroShit(state:Int) {
        if (PlayState.instance?.playerStrumline?.strumlineNotes == null) return;
        var playerArrow = PlayState.instance.playerStrumline.strumlineNotes.members[3 - state];
        var opponentArrow = PlayState.instance.opponentStrumline.strumlineNotes.members[state];
        var defPy:Float = PlayState.instance.playerStrumline.y;
        var defOy:Float = PlayState.instance.opponentStrumline.y;

        DpzGlobalsModule.cancelTweensOf(playerArrow); // Stops arrow's fading in, just in case
        DpzGlobalsModule.cancelTweensOf(opponentArrow);
        DpzGlobalsModule.shakeCameras(0.002, 0.002, 1);

        playerArrow.alpha = 0;
        opponentArrow.alpha = 0;
        playerArrow.visible = true;
        opponentArrow.visible = true;

        playerArrow.y = defPy + (Preferences.downscroll ? -25 : 25);
        DpzGlobalsModule.tween(playerArrow, {y: defPy, alpha: 1}, 1.22, {ease: FlxEase.cubeOut});
        opponentArrow.y = defOy + (Preferences.downscroll ? -25 : 25);
        DpzGlobalsModule.tween(opponentArrow, {y: defOy, alpha: 1}, 1.22, {ease: FlxEase.cubeOut});
	}

    function terminationOutroShit(state:Int, isPlayer:Bool) {
        if (PlayState.instance == null) return;
        var daArrow = (isPlayer ? PlayState.instance.playerStrumline.strumlineNotes.members[state] : PlayState.instance.opponentStrumline.strumlineNotes.members[state - 4]);
        DpzGlobalsModule.tween(daArrow, {alpha: 0}, 1.1, {ease: FlxEase.sineInOut});
    }

    function terminationEnd() {
        if (PlayState.instance == null) return;

        for (i in 0...PlayState.instance.playerStrumline.strumlineNotes.members.length)
            var dummy = PlayState.instance.playerStrumline.strumlineNotes.members[i];
            if (dummy.alpha == 0) continue;
            DpzGlobalsModule.cancelTweensOf(PlayState.instance.playerStrumline.strumlineNotes.members[i]);
            DpzGlobalsModule.tween(PlayState.instance.playerStrumline.strumlineNotes.members[i], {alpha: 0}, 2.1, {ease: FlxEase.sineInOut});

        for (i in 0...PlayState.instance.opponentStrumline.strumlineNotes.members.length)
            var dummy = PlayState.instance.opponentStrumline.strumlineNotes.members[i];
            if (dummy.alpha == 0) continue;
            DpzGlobalsModule.cancelTweensOf(PlayState.instance.opponentStrumline.strumlineNotes.members[i]);
            DpzGlobalsModule.tween(PlayState.instance.opponentStrumline.strumlineNotes.members[i], {alpha: 0}, 2.1, {ease: FlxEase.sineInOut});
    }

    ////---Fkin Arrow Helpers
    // Returns an static arrow. 0-3: Opponent Arrows; 4-7 Player Arrows;
    function getArrowNote(note:Int):StrumlineNote {
        if (note < 4) return PlayState.instance.opponentStrumline.strumlineNotes.members[note];
        return PlayState.instance.playerStrumline.strumlineNotes.members[note - 4];
    }

    // Gets a pincer according to a note
    function getArrowPincer(note:Int):FunkinSprite {
        switch(note) {
			case 0: // how does the "or" work here-?
				return pincer1;
            case 4:
				return pincer1;
			case 1:
				return pincer2;
            case 5:
				return pincer2;
			case 2:
				return pincer3;
            case 6:
				return pincer3;
			case 3:
				return pincer4;
            case 7:
				return pincer4;
			default:
				trace("Fkin idiot, that note doesn't exist!" + note); // Spiceful
                return null;
		}
    }

    function isPico():Bool {return DpzGlobalsModule.isPico();}
}