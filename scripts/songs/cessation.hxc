package dipazio.song;

import flixel.FlxG;
import funkin.graphics.FunkinSprite;
import flixel.tweens.FlxEase;
import flixel.util.FlxTimer;
import funkin.audio.FunkinSound;
import funkin.play.PlayState;
import dipazio.song.DpzSong;
import flixel.util.FlxColor;
import funkin.modding.module.ModuleHandler;
import funkin.util.TouchUtil;

class QTCessationSong extends DpzSong {
    var cessationTroll:FunkinSprite;
    var getsDaJoke:Bool = false;
    var canSkipEndScreen:Bool = false;
    var endTimer:FlxTimer = null;

    public function new() {
        super('cessation', null,
        {
            startDialogue: false, // Boolean, needs explanation?
            endDialogue: true, // Boolean
            freeplayDialogue: false, // Boolean
            discordRich: true, // Boolean
            albumMod: "QT" // String, the external site link getter for the songs album cover
        });
    }

    function rollDice() {
        if (DpzSong.debugMode) getsDaJoke = true;
        else getsDaJoke = FlxG.random.bool(20);
    }

    override public function onDestroy(event):Void {
        super.onDestroy(event);
        endTimer?.cancel();
        endTimer?.destroy();
    }

    override function onCreate(event:ScriptEvent):Void {
        super.onCreate(event);
        rollDice();
        canSkipEndScreen = false;
        initDummyAssets();
    }

    override function onUpdate(elapsed:Float):Void {
		super.onUpdate(elapsed);

        if (!canSkipEndScreen) return;

        if (FlxG.keys.pressed.ANY || (FlxG.onMobile && TouchUtil.justPressed)) {
            canSkipEndScreen = false;
            trace("DISPLAYED END SONG------------");
            PlayState.instance?.endSong();
            return;
        }
    }

    override function onSongRetry(event:ScriptEvent) {
        super.onSongRetry(event);
        rollDice();
        canSkipEndScreen = false;
    }

    override public function onFinalDialogueEnd(event):Void {
        endScreenHazard();
        //PlayState.instance.endSong();
    }

    private var getSecret:Bool = false;
    override function onBeatHit(event:SongTimeScriptEvent):Void {
        super.onBeatHit(event);

        if (event.beat < 160) return;
        if(event.beat == 163 || event.beat == 262) PlayState.instance?.currentStage?.getDad()?.scriptCall("setSuffix", ["alt"]);
        else if(event.beat == 199 || event.beat == 300) PlayState.instance?.currentStage?.getDad()?.scriptCall("setSuffix", ["together"]);

        if (!getsDaJoke) return;
        if(event.beat == 376 || event.beat == 377) handleFkinJoke(0);
        else if(event.beat == 378) {
            if (DpzGlobalsModule.getModOptions().get(DpzQTModule.DPZ_SAVE_KEY_QT_SECRET_CESSATION) != 0 && (DpzSong.debugMode || FlxG.random.bool(10))) {
                getSecret = true;
                handleFkinJoke(3);
            }
            else handleFkinJoke(1);
        }
        else if(event.beat == 379 && !getSecret) handleFkinJoke(2);
    }

    function initDummyAssets() {
        ModuleHandler.getModule("QTdodgeModule").scriptCall("initSawAssets");
        cessationTroll = FunkinSprite.create(0, 0, 'hazardStuff/qt-port/justkidding' + DpzGlobalsModule.getLanguageSuffix());
        cessationTroll.setGraphicSize(Std.int(cessationTroll.width * 0.9));
        cessationTroll.cameras = [PlayState.instance.camHUD];
        cessationTroll.x = FlxG.width - 950;
        cessationTroll.y = 205;
        cessationTroll.visible = false;
        PlayState.instance.add(cessationTroll);

        PlayState.instance.currentStage.getNamedProp('FG').loadTexture("hazardStuff/qt-port/stage/streetFrontCute");
        PlayState.instance.currentStage.getNamedProp('BG').loadTexture("hazardStuff/qt-port/stage/streetBackCute");
    }

    public function endScreenHazard():Void { // For displaying the "thank you for playing" screen on Cessation
		var black:FunkinSprite = new FunkinSprite(0, 0).makeSolidColor(FlxG.width * 3, FlxG.height * 3, FlxColor.BLACK);
		black.scrollFactor.set();
		black.screenCenter();

		var screen:FunkinSprite = new FunkinSprite(-600, -480).loadTexture('hazardStuff/qt-port/FinalScreen' + DpzGlobalsModule.getLanguageSuffix());
		screen.setGraphicSize(0, Std.int(FlxG.height)); // Fits it to the height of the screen, the width..., who cares?
		screen.scrollFactor.set();
		screen.screenCenter();

		var hasTriggeredAlready:Bool = false;
		screen.alpha = 0;
		black.alpha = 0;
		PlayState.instance.add(black);
		PlayState.instance.add(screen);

		DpzGlobalsModule.tween(PlayState.instance.camHUD, {alpha: 0}, 1, {ease: FlxEase.linear});
		endTimer = new FlxTimer().start(0.15, function(swagTimer:FlxTimer) {
			black?.alpha += 0.075;
			if (black?.alpha < 1) swagTimer.reset();
			else {
				screen?.alpha += 0.075;
				if (screen?.alpha < 1) swagTimer.reset();
                else {
                    if (PlayState.instance != null) canSkipEndScreen = true;
                    // Wait 12 seconds, then do shit -Haz
                    new FlxTimer().start(10, function(tmr:FlxTimer) {
                        if (PlayState.instance != null) {
                            if(!hasTriggeredAlready && canSkipEndScreen) {
                                hasTriggeredAlready = true;
                                PlayState.instance?.endSong();
                            }
                        }
                    });
                }
			}
		});		
	}

    function handleFkinJoke(hahaTakeIt:Int = 0) {
        switch (hahaTakeIt) {
            case 0: // fkin awh hell naw
                ModuleHandler.getModule("QTdodgeModule").scriptCall("handleAlert", ["", 1, false]);
                if (DpzGlobalsModule.getModOptions().get(DpzQTModule.DPZ_SAVE_KEY_QT_SECRET_CESSATION) == 0) {
                    DpzGlobalsModule.getModOptions().set(DpzQTModule.DPZ_SAVE_KEY_QT_SECRET_CESSATION, 1);
                    trace("first time?");
                }
            case 1: // fkin get trolled loser
                cessationTroll.visible = true;
                FunkinSound.playOnce(Paths.sound("hazard/bruh"), 0.75);
            case 2: // fkin gud end
                cessationTroll.visible = false;
            case 3: // MUEHEHEHEHEHEHHE
                DpzGlobalsModule.getModOptions().set(DpzQTModule.DPZ_SAVE_KEY_QT_SECRET_CESSATION, 2); // yay?
                ModuleHandler.getModule("QTdodgeModule").scriptCall("handleSawblade", [1]);
        }
    }
}