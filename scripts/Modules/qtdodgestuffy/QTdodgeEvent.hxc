import funkin.Paths;
import funkin.Conductor;
import flixel.util.FlxTimer;
import funkin.play.PlayState;
import funkin.audio.FunkinSound;
import funkin.play.event.SongEvent;
import funkin.graphics.FunkinSprite;
import funkin.modding.module.ModuleHandler;
import funkin.play.scoring.Scoring;
import funkin.play.stage.Bopper;

class QTdodgeEvent extends SongEvent {
    public function new() {
        super('KB_AttackFire');
    }

    public override function handleEvent(data:SongEventData) {
        Conductor.instance.update();
        PlayState.instance.mayPauseGame = false;
        ModuleHandler.getModule("DodgeModuleQT").scriptCall("handleSawblade", [data.value.snd]);
    }

    public override function getTitle():String
    {
        return "Dodge Sawblade Event (QT)";
    }

    public override function getEventSchema()
    {
        return [            {
                name: 'snd',
                title: 'Sound Number',
                defaultValue: 1,
                min: 1,
                max: 4,
                step: 1,
                type: "integer"
            },
        ];
    }
}