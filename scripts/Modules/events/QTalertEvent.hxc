import funkin.Paths;
import funkin.play.PlayState;
import funkin.audio.FunkinSound;
import funkin.play.event.SongEvent;
import funkin.play.stage.Bopper;
import funkin.modding.module.ModuleHandler;
import funkin.Conductor;

class QTalertEvent extends SongEvent {
    public function new() {
        super('KB_Alert');
    }

    override function handleEvent(data:SongEventData):Void {
        if (DpzQTModule.disabledSaws()) return;
        var alertV:String = "";
        var prepareS:Bool = data.value.prep_saw ?? false;
        switch(data.value.count) {
            case 2:
                alertV = "DOUBLE";
            case 3:
                alertV = "TRIPLE";
            case 4:
                alertV = "QUAD";
            default:
                alertV = "";
        }
        Conductor.instance.update();
        ModuleHandler.getModule("QTdodgeModule").scriptCall("handleAlert", [alertV, data.value.count, prepareS]);
    }

    public override function getTitle():String {
        return "Alert Event (QT)";
    }

    public override function getEventSchema() {
        return [
            {
                name: 'count',
                title: 'Count',
                defaultValue: 1,
                min: 1,
                max: 4,
                step: 1,
                type: "integer",
                units: 'saws'
            },
            {
                name: 'prep_saw',
                title: 'Prepare Sawblade',
                defaultValue: false,
                type: "bool"
            }
        ];
    }
}