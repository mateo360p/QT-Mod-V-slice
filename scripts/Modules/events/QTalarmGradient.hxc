import flixel.FlxG;
import funkin.play.PlayState;
import flixel.tweens.FlxEase;
import funkin.play.event.SongEvent;
import funkin.graphics.FunkinSprite;
import flixel.util.FlxColor;
import flixel.FlxCamera;
import funkin.modding.module.ModuleHandler;

class QTAlarmGradientEvent extends SongEvent {
    public function new() {
        super('Alarm Gradient');
    }

    public override function handleEvent(data:SongEventData) {
        var alarmSide:String = Std.string(data.value.value1); // Just in case-
        var targetAlpha:Float = Std.parseFloat(data.value.value2);
        if(Math.isNaN(targetAlpha)) targetAlpha = 0;

        var alarmLeft:Bool = null;
        if(alarmSide.toLowerCase() == "left") alarmLeft = true;
        else if(alarmSide.toLowerCase() == "right") alarmLeft = false;
        else return;

        ModuleHandler.getModule("QTdodgeModule").scriptCall("handleAlarm", [alarmLeft, targetAlpha]);
    }

    public override function getTitle():String {
        return "Alarm Gradient Event (QT)";
    }

    public override function getEventSchema() {
        return [
            {
                name: 'value1',
                title: 'Alarm Side',
                type: "enum",
                defaultValue: 'left',
                keys: [
                    'Left Side' => 'left',
                    'Right Side' => 'right'
                ]
            },
            {
                name: 'value2',
                title: 'Alpha',
                type: "float",
                defaultValue: 0.5,
                min: 0.0,
                step: 0.05,
                max: 1.0
            },
        ];
    }
}