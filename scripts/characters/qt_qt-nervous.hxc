package funkin.play.character;

import flixel.FlxG;
import funkin.audio.FunkinSound;
import funkin.play.PlayState;
import funkin.Conductor;
import flixel.math.FlxPoint;
import funkin.play.character.VsQTKillerBotCharacter;

using StringTools;

class VsQTNervousCharacter extends VsQTKillerBotCharacter
{
  final glitchStages:Array<String> = ['qtKBStreet', 'qtRealStreet', 'qtCessationStreet'];

  public function new(characterId:String)
  {
    if (characterId == "UNKNOWN") {
      characterId = "qt_qt-nervous";
    }
    super(characterId);
  }

  override function getDefaultDrain():FlxPoint {
    return FlxPoint.get(0.0115, 1.125);
  }

  override function resetIdle():Void {}

  function fetchAssetPaths():Array<String> {
      var results:Array<String> = super.fetchAssetPaths();
      for (i in 1...4) results.push(Paths.sound('hazard/glitch-error0' + i));
      return results;
  }

  override public function playSingAnimation(dir:NoteDirection, miss:Bool = false, ?suffix:String = ''):Void
  {
    var altAnim:String = '';
    if (DpzGlobalsModule.qualityLevel(1) && FlxG.random.bool(100 / 18)) {
				altAnim = 'alt';
        FunkinSound.playOnce(Paths.sound('hazard/glitch-error0' + FlxG.random.int(1, 3)));
        randomGlitch(); // 10% chance of an eye appearing on TV when glitching
    }

    super.playSingAnimation(dir, miss, suffix + altAnim);
  }

  function randomGlitch():Void {
    if (!FlxG.random.bool(10)) return;
    if (!glitchStages.contains(DpzGlobalsModule.curStageID())) return;
    if (DpzGlobalsModule.curSongID() != "careless" || (Conductor.instance?.currentBeat >= 190 && Conductor.instance?.currentStep <= 898)) return;

    PlayState.instance?.currentStage?.getNamedProp("TV")?.playAnimation("eye" + (FlxG.random.bool(52) ? "Left" : "Right"), true);
    PlayState.instance?.currentStage?.getNamedProp("TV")?.animation?.finishCallback = function(daAnim:String)
    {
      if(daAnim == 'eyeLeft' || daAnim == 'eyeRight'){
        PlayState.instance?.currentStage?.getNamedProp("TV")?.playAnimation("idle", true);
        PlayState.instance?.currentStage?.getNamedProp("TV")?.animation.finishCallback == null;
      }
    }
  }
}
