package funkin.play.character;

import flixel.FlxG;
import funkin.play.character.MultiAnimateAtlasCharacter;
import funkin.play.PlayState;
import funkin.util.Constants;
import flixel.math.FlxPoint;

using StringTools;

class VsQTKillerBotCharacter extends MultiAnimateAtlasCharacter
{
  var qt_hpDrainMultiplier:Float = 0.5925;
  var qt_lossMultiplier:Float = 1.0;

  function getDefaultDrain():FlxPoint {
    return FlxPoint.get(0.01185, 1.0);
  }

  function resetIdle():Void {
    this.idleSuffix = '';
    this.shouldAlternate = true;
  }

  public function new(characterId:String)
  {
    if (characterId == "UNKNOWN") {
      characterId = "qt_kb";
    }
    super(characterId);
  }

  override public function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);
    var defDrain:FlxPoint = getDefaultDrain();
    setDrain(defDrain.x, defDrain.y);
    resetIdle();
  }

  override function onUpdate(event:UpdateScriptEvent):Void {
    super.onUpdate(event);
    if (!DpzQTModule.disabledTricks()) drainHoldNote(event.elapsed);
  }

  function onSongRetry(event:ScriptEvent):Void {
    super.onSongRetry(event);

    var defDrain:FlxPoint = getDefaultDrain();
    setDrain(defDrain.x, defDrain.y);
    resetIdle();
  }

  function onNoteHit(event:HitNoteScriptEvent):Void {
		super.onNoteHit(event);
    if (DpzQTModule.disabledTricks() || PlayState.instance == null) return;
		if (event.note.noteData.getMustHitNote() || !canDrain(Constants.HEALTH_SICK_BONUS)) return;

    PlayState.instance.health -= (Constants.HEALTH_SICK_BONUS * qt_hpDrainMultiplier) / ((!DpzGlobalsModule.hasKeyboard()) ? 2 : 1);
	}

  function onNoteMiss(event:NoteScriptEvent):Void {
    super.onNoteMiss(event);
    if (DpzQTModule.disabledTricks() || PlayState.instance == null || !DpzGlobalsModule.hasKeyboard()) return;
    if (!event.note.noteData.getMustHitNote()) return; // idk

    PlayState.instance.health += (Constants.HEALTH_MISS_PENALTY * (1 - qt_lossMultiplier));
  }

  function drainHoldNote(elapsed:Float):Void {
    if (PlayState.instance?.opponentStrumline?.holdNotes == null) return;
    for (holdNote in PlayState.instance.opponentStrumline.holdNotes.members)
    {
      if (!holdNote?.alive || holdNote?.noteData == null) continue;

      // While the hold note is being hit, and there is length on the hold note...
      if (holdNote.hitNote && !holdNote.missedNote && holdNote.sustainLength > 0 && canDrain(Constants.HEALTH_HOLD_BONUS_PER_SECOND)) {
        PlayState.instance.health -= ((Constants.HEALTH_HOLD_BONUS_PER_SECOND * qt_hpDrainMultiplier) * elapsed) / ((!DpzGlobalsModule.hasKeyboard()) ? 2 : 1);
      }
    }
  }

  // Sooo this gets a value, and then converts it into a multiplier for the V-Slice health drain
  // in QT, the HP gained when hitting a note is 0.02, in V-Slice is 0.03 (I think)
  // Soo, to get the HPdrain equivalent here, we divide the QT mod value by its HP gain (0.02)
  function setDrain(rawDrainValue:Float, rawLossMultiplier:Float = null):Void {
    if (rawDrainValue != null) this.qt_hpDrainMultiplier = rawDrainValue / 0.02; // 0.02 is the healthDrain on QT mod (I think)
    if (rawLossMultiplier != null) this.qt_lossMultiplier = rawLossMultiplier;
  }

  function canDrain(drain:Float):Bool {
    if (PlayState.instance == null || drain == null) return false;
    return (PlayState.instance.health - qt_hpDrainMultiplier*drain - 0.1 > Constants.HEALTH_MIN);
  }
}
