package funkin.play.character;

import funkin.play.character.VsQTKillerBotCharacter;

using StringTools;

class VsQTdaQTandKillerBotCharacter extends VsQTKillerBotCharacter
{
  public var animSuffix:String = "";

  public function new(characterId:String)
  {
    if (characterId == "UNKNOWN") {
      characterId = "qt_qt-kb";
    }
    super(characterId);
  }

  public function setSuffix(daSuffix:String = "") {
    animSuffix = daSuffix;

    if (daSuffix == "together") daSuffix = "";
    this.idleSuffix = (daSuffix == "" ? daSuffix : '-$daSuffix');
    this.shouldAlternate = true;
  }

  override function resetIdle():Void {
    animSuffix = "";
    super.resetIdle();
  }

  override public function update(elapsed:Float) {
    super.update(elapsed);
    if (FlxG.keys.justPressed.I) {
      trace(getCurrentAnimation());
    }
  }

  override public function playSingAnimation(dir:NoteDirection, miss:Bool = false, ?suffix:String = ''):Void {
    //trace('sing${dir.nameUpper}${miss ? 'miss' : ''}${(animSuffix + suffix) != '' ? '-${animSuffix + suffix}' : ''}');
    super.playSingAnimation(dir, miss, animSuffix + suffix);
  }

  override function canDrain(drain:Float):Bool {
    if (animSuffix == "") return false;
    return super.canDrain(drain);
  }
}
