package funkin.play.character;

import flixel.effects.FlxFlicker;
import flixel.FlxG;
import flixel.FlxSprite;
import flixel.group.FlxTypedSpriteGroup;
import flixel.tweens.FlxTween;
import flixel.util.FlxTimer;
import funkin.audio.FunkinSound;
import funkin.graphics.FunkinSprite;
import funkin.modding.base.ScriptedFunkinSprite;
import funkin.modding.module.ModuleHandler;
import funkin.play.character.CharacterType;
import funkin.play.character.MultiSparrowCharacter;
import funkin.play.GameOverSubState;
import funkin.play.PauseSubState;
import funkin.play.PlayState;
import funkin.util.Constants;
import funkin.util.HapticUtil;
import funkin.Preferences;
import funkin.FunkinMemory;
import funkin.play.character.PicoPlayerBaseCharacter;

using StringTools;

class VSQTPicoPlayerCharacter extends PicoPlayerBaseCharacter
{
  var heySound:FunkinSound;
  var isDodging:Bool = false;
  var deathQTbloodRetry:FunkinSprite;

  public function new(characterId:String)
  {
    if (characterId == "UNKNOWN")
    {
      characterId = "qt_pico";
    }

    super(characterId);

    ignoreExclusionPref.push("hey");
    ignoreExclusionPref.push("dodge");
  }

  override public function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);
    heySound = FunkinSound.load(Paths.sound('qt_mdfkinbeautifulhey-pico'), 1.0, false, false, false);
  }

  override public function onSongRetry(event:ScriptEvent):Void
  {
    isDodging = false;
    super.onSongRetry(event);
  }

  override public function onGameOver(event:ScriptEvent):Void
  {
    isDodging = false;
    super.onGameOver(event);
  }

  override public function dance(force:Bool = false):Void
  {
    if (isDead) return;

    if (!force) {
      var currentAnimation:String = getCurrentAnimation();
      if (currentAnimation == null) return;
      if (!currentAnimation.startsWith('dance') && !currentAnimation.startsWith('idle')
        && !currentAnimation.startsWith('dodge') && !isAnimationFinished()) return;
    }

    if (!force) force = getCurrentAnimation().startsWith('dodge');

    super.dance(force);
  }

  override public function onUpdate(elapsed:Float):Void
  {
    super.onUpdate(elapsed);

    if (PlayState.instance == null) return;

      if (DpzQTModule.tauntJustPressed() && !isDodging && !PlayState.instance.disableKeys && !PlayState.instance.isInCutscene && PlayState.instance.subState == null && !isHoldingNote() && getCurrentAnimation() != "hey" && !getCurrentAnimation().endsWith("miss"))
        doHey();

      if (FlxG.keys.justPressed.K) {
        trace('CUR POSITION: X = ' + x + ", Y = " + y);
        trace('CUR OFFSET: X = ' + animOffsets[0] + ", Y = " + animOffsets[1]);
      }
  }

  function createQTblood() {
    deathQTbloodRetry = FunkinSprite.createSparrow(532, 134, "characters/qt-port/pico_qt_retry");

    deathQTbloodRetry.animation.addByPrefix('start', "bloody Retry0", 24, false);
    deathQTbloodRetry.animation.addByPrefix('idle', "retry idle0", 24, true);
    deathQTbloodRetry.animation.addByPrefix('confirm', "retry confirm0", 24, false);

    deathQTbloodRetry.zIndex = zIndex - 2;
    deathQTbloodRetry.visible = false;

    GameOverSubState.instance?.add(deathQTbloodRetry);
    GameOverSubState.instance?.refresh();
  }

  override public function onAnimationFrame(name:String, frameNumber:Int, frameIndex:Int)
  {
    if (this.debug) return;

    super.onAnimationFrame(name, frameNumber, frameIndex);

    if (name == "firstDeath-qtSaw" && frameNumber == 33)
    {
      deathQTbloodRetry?.animation?.play('start');
      deathQTbloodRetry?.visible = true;
    }
  }

  var reposBloodR:Bool = false; // juicy
  override public function playAnimation(name:String, restart:Bool = false, ignoreOther:Bool = false, reversed:Bool = false):Void
  {
    // restore vocal volume to ensure burps always play
    // not needed on the dark variant because this one always exists anyway..
    if (name == "burpShit" || name == "burpSmile" || name == "burpSmileLong") PlayState.instance.vocals.playerVolume = 1;

    if (name == "firstDeath-qtSaw") 
    {
      reposBloodR = false;
      createQTblood();
    }
    else if (name == "deathLoop-qtSaw")
    {
      deathQTbloodRetry?.animation?.play('idle');
      reposBloodR = true;
    }
    else if (name == "deathConfirm-qtSaw")
    {
      deathQTbloodRetry?.animation?.play('confirm');
      if (reposBloodR) {
        deathQTbloodRetry?.x -= 150;
        deathQTbloodRetry?.y += 10;
      }
      return;
    }
    else if (name == "firstDeath")
    {
      if (GameOverSubState.animationSuffix != '') {
        playAnimation("firstDeath" + GameOverSubState.animationSuffix);
        return;
      }
    }
    else if (name == "deathConfirm")
    {
    } else if (isDodging && !name.startsWith("dodge")) {
      return;
    }

    super.playAnimation(name, restart, ignoreOther, reversed);
  }

  public function doHey():Void // fkin best idea ever
  {
    playAnimation("hey", true);
    heySound?.play(true);
    holdTimer = 0;
  }
}
